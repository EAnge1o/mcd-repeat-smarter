# ---------------------------------------------------------------
# 麦当劳 MCP Token（必填）
# 申请地址：https://open.mcd.cn/mcp  → 手机号登录 → 控制台 → 激活
# 该 Token 只在服务端读取，不会下发到浏览器。
# ---------------------------------------------------------------
MCD_MCP_TOKEN=your_mcd_mcp_token_here

# MCP 远程服务地址（一般不需要改）
MCD_MCP_URL=https://mcp.mcd.cn

# 服务端监听端口
PORT=8787

# 默认门店编码（可选）。留空时由用户在界面里选择门店。
# 示例：1450543
MCD_DEFAULT_STORE_CODE=

# 默认城市（用于门店搜索的初始值）
MCD_DEFAULT_CITY=上海市

# 默认点餐方式：1 到店自取 / 2 麦乐送 / 5 得来速 / 6 企业团餐
# 当前版本 UI 只开放「到店自取」，这个值用于 mcp:probe 自检脚本
MCD_DEFAULT_BE_TYPE=1

# 常用方案的落盘目录（默认 ./data）。已在 .gitignore 中排除，不会提交。
DATA_DIR=

# 演示模式：true 时即使没有 Token 也能浏览界面与演示数据，
# 但所有结果都会在 UI 上明确标记为「演示数据」。
DEMO_MODE=false
